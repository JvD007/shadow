# GridWeave Inspector — required environment variables
# Copy to .env and fill in real values. NEVER commit real secrets.

# ---- GridWeave authentication (required) ----
GRIDWEAVE_TOKEN=your_jwt_here
GRIDWEAVE_PLATFORM_URL=https://platform.gridweave.ai

# ---- Garage / S3-compatible object store (required for run) ----
GARAGE_ENDPOINT_URL=https://garage.example.com
GARAGE_BUCKET=your-bucket
GARAGE_PREFIX=your/prefix/
GARAGE_ACCESS_KEY=your_access_key
GARAGE_SECRET_KEY=your_secret_key
GARAGE_REGION=garage

# ---- Optional ----
# Path to the Python interpreter that has gridweave + ray + boto3 + pandas
# installed. Defaults to "python3" on PATH if unset.
# PYTHON_BIN=/opt/venv/bin/python

# Set to "1" to force the demo fallback (no real GridWeave call) so the UI
# still demonstrates the full layout without secrets. Useful for previews.
# GRIDWEAVE_DEMO=1
